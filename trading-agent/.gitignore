grid_t1s_*.json
grid_t2_*.json
phase41_*.csv
phase5_explore_results.csv
realistic_results.csv
*_trades.csv

# ── Scripts de recherche (drivers, hors runtime) ──
run_*.py
backtest_*.py
fetch_p2_data.py
fetch_kraken_5m.py

# ── Caches de données marché ──
kraken_cache/
kraken_cache_p2/
