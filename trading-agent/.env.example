# ── Jim Bot — Kraken Futures (stratégie GEO) ─────────────────────────────────
# Copie ce fichier vers .env puis remplis tes clés.
#   cp .env.example .env && chmod 600 .env

# Broker actif (kraken | bybit | alpaca)
ACTIVE_BROKER=kraken

# ── Kraken Futures ────────────────────────────────────────────────────────────
# Clés API générées sur https://futures.kraken.com (Settings → API Keys)
# Permissions : General info + Full access (trading) sur Futures
# ⚠️  Whitelist l'IP de ton VPS européen sur la clé pour limiter le risque
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# 1 = démo (demo-futures.kraken.com, compte séparé), 0 = LIVE
KRAKEN_PAPER=0

# ═════════════════════════════════════════════════════════════════════════════
# Phase 1 — Validation live à petit capital (ETH seul, ~30 trades)
# ═════════════════════════════════════════════════════════════════════════════
INITIAL_CAPITAL=100
GEO_SYMBOLS=ETH/USD
GEO_MAX_SIM=1
GEO_POS_PCT=0.50
GEO_ENABLE_SHORT=0      # commence long-only pour valider la mécanique

# ═════════════════════════════════════════════════════════════════════════════
# Phase 2 — Après ~30 trades paper/live OK, décommente ce bloc et commente Phase 1
# ═════════════════════════════════════════════════════════════════════════════
# INITIAL_CAPITAL=1000
# GEO_SYMBOLS=ETH/USD,SOL/USD
# GEO_MAX_SIM=2
# GEO_POS_PCT=0.50
# GEO_ENABLE_SHORT=1    # active le short miroir (+16% net attendu sur backtest)

# ── Dashboard Flask ──────────────────────────────────────────────────────────
PORT=5000
