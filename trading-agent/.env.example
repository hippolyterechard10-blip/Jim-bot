# ── Jim Bot — Kraken Futures (stratégie GEO) ─────────────────────────────────
# Copie ce fichier vers .env puis remplis tes clés.
#   cp .env.example .env && chmod 600 .env

# Broker actif (kraken | bybit | alpaca)
ACTIVE_BROKER=kraken

# ── Kraken Futures ────────────────────────────────────────────────────────────
# Clés API générées sur https://futures.kraken.com (Settings → API Keys)
# Permissions : General info + Full access (trading) sur Futures
# ⚠️  Whitelist l'IP de ton VPS européen sur la clé pour limiter le risque
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# 1 = paper / démo (demo-futures.kraken.com, compte séparé du live)
# 0 = LIVE (futures.kraken.com / pro.kraken.com)
# Démarre en paper (1) tant que la mécanique n'est pas validée.
KRAKEN_PAPER=1

# ═════════════════════════════════════════════════════════════════════════════
# Phase 1 — Validation mécanique live ($100, ETH seul, ~30 trades)
# ─────────────────────────────────────────────────────────────────────────────
# POS_PCT=1.00 + MAX_SIM=1 : 100 % du capital sur une seule position à la fois.
# SHORT=1 dès le départ : on valide TOUT le code (long + short) à faible enjeu
#   plutôt qu'attendre Phase 2 pour découvrir un bug sur le chemin short.
# Max perte/trade ≈ 0.7-0.8 % = -$0.80. Flash-crash max ≈ -$3. Accepté.
# ═════════════════════════════════════════════════════════════════════════════
INITIAL_CAPITAL=100
GEO_SYMBOLS=ETH/USD
GEO_MAX_SIM=1
GEO_POS_PCT=1.00
GEO_ENABLE_SHORT=1

# ═════════════════════════════════════════════════════════════════════════════
# Phase 2 — Après ~30 trades OK, remplace les 5 lignes ci-dessus par celles-ci
# ⚠️  IMPORTANT : repasser POS_PCT à 0.50 — sinon tu tentes 200 % de margin
#                 avec MAX_SIM=2 (ordres rejetés + risque liquidation)
# ═════════════════════════════════════════════════════════════════════════════
# INITIAL_CAPITAL=1000
# GEO_SYMBOLS=ETH/USD,SOL/USD
# GEO_MAX_SIM=2
# GEO_POS_PCT=0.50
# GEO_ENABLE_SHORT=1    # active short miroir (+16% net attendu sur backtest)

# ── Dashboard Flask ──────────────────────────────────────────────────────────
PORT=5000
